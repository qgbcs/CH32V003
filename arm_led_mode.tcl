# arm_led_mode.tcl
# ------------------------------------------------------------------
# 武装红灯模式: 固件默认保持 SDI 常开, 只有 SRAM 邮箱出现两把钥匙时
# 才关闭 SDI 并把 PD1 让给红灯。本脚本 halt 后写入邮箱再 resume。
# 掉电后 SRAM 丢失, 重新上电即恢复调试口, 无需救砖。
#
# 邮箱地址 / 钥匙必须与 led_scan/led_scan.c 完全一致:
#   0x20000700 = 0x57434831 ("WCH1")
#   0x20000704 = 0x4c454431 ("LED1")
# ------------------------------------------------------------------

init
halt
mww 0x20000700 0x57434831
mww 0x20000704 0x4c454431
resume

# 固件启动横幅 printf 在无主机时最多等待约 400ms, 之后才会轮询邮箱;
# SDI 在那之前不会关。趁 SDI 还开着干净退出, 固件随后自行关闭 SDI。
after 100
shutdown
